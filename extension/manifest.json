{
  "manifest_version": 3,
  "name": "Delta — локальный бэкап вкладок",
  "version": "1.5.1",
  "author": "21stme@",
  "description": "Локальный бэкап открытых вкладок Delta или выбранных ссылок из истории браузера с ожиданием загрузки и отчётом.",
  "permissions": [
    "tabs",
    "scripting",
    "downloads"
  ],
  "optional_permissions": [
    "tabGroups",
    "history"
  ],
  "host_permissions": [
    "https://delta.yandex-team.ru/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Бэкап вкладок Delta",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
